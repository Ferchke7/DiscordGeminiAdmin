# === Обязательные секреты ===
Discord__Token=YOUR_DISCORD_BOT_TOKEN
Gemini__ApiKey=YOUR_GEMINI_API_KEY

# === Модели Gemini ===
Gemini__Models__Moderation=gemini-2.5-flash
Gemini__Models__Structure=gemini-2.5-pro
Gemini__Models__Embedding=text-embedding-004
Gemini__EmbeddingDimensions=768

# === База данных PostgreSQL (с расширением pgvector) ===
POSTGRES_USER=dga
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=discord_gemini_admin
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=discord_gemini_admin;Username=dga;Password=CHANGE_ME_STRONG_PASSWORD

# === Настройки авто-бана и часового дайджеста ===
AutoBan__Enabled=true
AutoBan__DryRun=true
AutoBan__MinConfidence=0.95
AutoBan__MinEvidenceMessages=3
AutoBan__MaxPerHour=3
Digest__Cron=0 * * * *
Retention__MessageBufferHours=24
